LPR_DB_USERNAME=postgres
LPR_DB_PASSWORD=
LPR_DB_DATABASE=pacs-lpr

DEMO_MODE=false
DEMO_EMAIL=

YACAPTCHA_ENABLED=false
YACAPTCHA_SECRET=
YACAPTCHA_CLIENT=

FRP_PORTAL_URL=https://my.grapespacs.ru
FRP_SERVER_ADDR=my.grapespacs.ru
