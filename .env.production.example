APP_NAME=PACS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
DOCKER_DOMAIN=
TZ=Europe/Moscow

LOG_CHANNEL=stack
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=app-database
DB_DATABASE=pacs
DB_USERNAME=pacs
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_LIFETIME=120
REDIS_HOST=redis

TRAEFIK_SERVICE=pacs
COMPOSE_FILE=docker-compose.production.yml
APP_VERSION=1.3.0
CERT_ADMIN_EMAIL=admin@example.ru
MOONSHINE_ROUTE_PREFIX=/

DADATA_TOKEN=
DADATA_SECRET=

MEDIA_SERVER_ENABLED=false
MEDIA_SERVER_VERSION=1.2.0
MEDIA_SERVER_API_URL=http://media-server:8081
MEDIA_SERVER_RTSP=rtsp://media-server:8554
MEDIA_SERVER_WEBRTC_PROFILE=original
MEDIA_SERVER_WEBRTC_UDP_PORT=8189
MEDIA_SERVER_WEBRTC_PUBLIC_IP=

ANALYTIC_ENABLED=false
ANALYTIC_VERSION=1.2.0
ADB_HOST=analytic-database
ADB_PORT=5432
ADB_USERNAME=postgres
ADB_PASSWORD=
ADB_DATABASE=pacs-analytic
ANALYTIC_HOST=http://analytic-api:8082
ANALYTIC_TIMEOUT=10
ANALYTIC_TIMEDELAY=200
MIN_WIDTH_PHOTO=50
MOTION_MIN_AREA=500
MOTION_THRESHOLD=25
MOTION_RECORD_AFTER_TIME=3
EUCLIDEAN_THRESHOLD=0.6
MAX_FACES_IN_LIST=25
CAMERA_POLL_INTERVAL=5

LPR_ENABLED=false
